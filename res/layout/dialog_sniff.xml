<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Observe mode"
        style="@style/GhostWire.Header" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:text="Passive capture of the polling frames a nearby reader sends. Hold the phone to a reader; newest frame first." />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/GhostWire.Card">

        <ScrollView
            android:id="@+id/sniff_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="360dp">

            <TextView
                android:id="@+id/sniff_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textIsSelectable="true"
                android:textColor="?attr/colorOnSurface" />
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
