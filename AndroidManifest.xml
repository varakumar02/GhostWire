<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="org.ghostwire"
          android:versionCode="1"
          android:versionName="0.1">

    <!-- SIM lab: EF reads + raw APDU. iccTransmitApdu*/getSubscriberId are gated
         by MODIFY_PHONE_STATE / READ_PRIVILEGED_PHONE_STATE, granted to this
         privileged platform-signed app via privapp-permissions-ghostwire.xml. -->
    <uses-permission android:name="android.permission.MODIFY_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PRIVILEGED_PHONE_STATE" />
    <!-- SDR tab: enumerate USB-OTG front-ends. -->
    <uses-permission android:name="android.permission.MANAGE_USB" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <!-- Recon tab: cell/neighbor scan + GPS need location (runtime-granted);
         OpenCelliD tower lookup needs network. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Map tab (osmdroid): tile downloads + connectivity checks. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Contactless (Walrus) tab: read cards with the phone's own NFC. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.nfc.hce" android:required="false" />
    <!-- BT scan (passive BLE advertisers + classic inquiry). BLUETOOTH_SCAN is
         self-granted as root at scan time; CONNECT is only for reading names. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Wi-Fi tab: passive scan (ACCESS_WIFI_STATE + location, self-granted as
         root) and, as a platform-signed privileged app, NETWORK_SETTINGS to read
         full scan results and bypass scan throttling. CHANGE_WIFI_STATE drives
         startScan / restoring Wi-Fi after monitor mode. NEARBY_WIFI_DEVICES is the
         Android 13+ runtime gate for scan results. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <uses-permission android:name="android.permission.NETWORK_SETTINGS" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <!-- Auto-scan: a foreground service keeps the "scanning" state + notification
         alive, so tapped tags keep being captured; POST_NOTIFICATIONS shows it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.GhostWire"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auto-scan entry: an invisible (translucent, no-history) trampoline.
             The OS dispatches a tapped tag here only while this component is
             enabled, which AutoScanService ties to the auto-scan toggle. It
             reads and saves the card in the background and finishes at once, so
             with auto-scan on a tap never opens GhostWire's UI; with auto-scan
             off the component is disabled and a tapped card is ignored. -->
        <activity
            android:name=".NfcCaptureActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_filter" />
        </activity>

        <service
            android:name=".AutoScanService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Host card emulation: serve a saved card's NDEF payload as an NFC
             Forum Type-4 tag (see org.ghostwire.emu). Category "other". -->
        <service
            android:name=".emu.GhostApduService"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/apduservice" />
        </service>

        <!-- Share exported card dumps out of the app's external files dir. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="org.ghostwire.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
